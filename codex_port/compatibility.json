{
  "commands": {
    "reflect": ["--dry-run", "--scan-history", "--days", "--targets", "--review", "--dedupe", "--organize", "--include-tool-errors", "--model"],
    "reflect-skills": ["--days", "--project", "--all-projects", "--dry-run"],
    "view-queue": [],
    "skip-reflect": []
  },
  "hooks": ["SessionStart", "UserPromptSubmit", "PreCompact", "PostToolUse"],
  "scripts": {
    "capture_learning.py": "reflect.py hook UserPromptSubmit",
    "check_learnings.py": "reflect.py hook PreCompact",
    "session_start_reminder.py": "reflect.py hook SessionStart",
    "post_commit_reminder.py": "reflect.py hook PostToolUse",
    "read_queue.py": "reflect.py queue",
    "clear_queue.py": "reflect.py clear --ids or --all",
    "project_paths.py": "reflect.py paths",
    "extract_session_learnings.py": "reflect.py scan",
    "extract_tool_rejections.py": "reflect.py scan (rejection records)",
    "extract_tool_errors.py": "reflect.py scan --include-tool-errors",
    "compare_detection.py": "reflect.py compare",
    "lib/reflect_utils.py": "scripts/vendor/reflect_utils.py plus reflect_core.py",
    "lib/semantic_detector.py": "scripts/vendor/semantic_detector.py plus semantic.py",
    "lib/__init__.py": "scripts/vendor/__init__.py"
  }
}
